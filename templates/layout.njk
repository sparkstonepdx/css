{% import "nav.njk" as nav %}
{% set current = slug or title or "index" %}
<!DOCTYPE html>
<html lang="en" data-color-scheme="light">
  <head>
    <meta charset="UTF-8" />
    <title>{% if title %}{{ title }} · {% endif %}@sparkstone/css</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="./classless.css" />
    <link rel="stylesheet" href="./docs.css" />
    <script src="./docs.js" type="module"></script>
  </head>
  <body>
    <header class="site-header">
      <button
        id="sidebar-toggle"
        class="ghost"
        aria-controls="site-sidebar"
        aria-expanded="false"
      >
        Menu
      </button>
      <strong><a href="./index.html" class="semantic">@sparkstone/css</a></strong>
      <nav class="flex site-links">
        <a href="https://github.com/sparkstonepdx/css">GitHub</a>
        <a href="https://www.npmjs.com/package/@sparkstone/css">npm</a>
        <button id="theme-toggle" class="ghost" aria-label="Toggle color scheme">Dark</button>
      </nav>
    </header>

    <div class="site-body">
      <aside class="site-sidebar" id="site-sidebar">
        <nav aria-label="Documentation">
          {% for group in nav.navGroups %}
            <p class="sidebar-group">{{ group[0] }}</p>
            <ul>
              {% for item in group[1] %}
                <li>
                  <a
                    href="./{{ item[0] }}.html"
                    {% if item[0] == current %}aria-current="page"{% endif %}
                    >{{ item[1] }}{% if item[2] %}<span class="kobalte-badge" title="Covered by the Kobalte layer">K</span>{% endif %}{% if item[3] %}<span class="alpha-badge retheme" title="Alpha: the look can change in a minor release">alpha</span>{% endif %}</a
                  >
                </li>
              {% endfor %}
            </ul>
          {% endfor %}
        </nav>
      </aside>

      <main class="site-main">
        {% block content %}{% endblock %}

        <footer class="site-footer">
          <hr />
          <p>
            <small>
              <a href="https://www.npmjs.com/package/@sparkstone/css">npm</a> ·
              <a href="https://github.com/sparkstonepdx/css">GitHub</a> ·
              MIT
            </small>
          </p>
        </footer>
      </main>
    </div>

    {% block scripts %}{% endblock %}
  </body>
</html>
