{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Link" %}
{% set slug = "link" %}

{% block content %}
<h1>Link</h1>
<p class="lede">
  Links use the accent color, which is the theme color rotated 180 degrees in
  <code>oklch</code> unless you set <code>--accent-color</code> yourself.
</p>

{{ m.classes([
  ["link", "Accent-colored text with a pointer cursor"]
]) }}

<h2>Basic</h2>
{% set classless %}
<p>Read the <a href="#">installation guide</a> to get started.</p>
{% endset %}
{% set classes %}
<p>Read the <a href="#" class="link">installation guide</a> to get started.</p>
{% endset %}
{{ m.demo("link-basic", classless, classes) }}

<h2>Recoloring</h2>
<p>Set <code>--accent-color</code> on any ancestor to change links in that subtree.</p>
{% set classless %}
<p style="--accent-color: teal">A <a href="#">teal link</a> inside a scoped block.</p>
{% endset %}
{% set classes %}
<p style="--accent-color: teal">A <a href="#" class="link">teal link</a> inside a scoped block.</p>
{% endset %}
{{ m.demo("link-scoped", classless, classes) }}

<h2>Unstyled links</h2>
{% set classless %}
<a href="#" class="semantic">No accent color, no underline</a>
{% endset %}
{% set classes %}
<a href="#">No accent color, no underline</a>
{% endset %}
{{ m.demo("link-semantic", classless, classes) }}
{{ m.classless_note("<code>.semantic</code> also removes the focus ring, since it unsets every property. Prefer the class build when you need unstyled links to stay keyboard accessible.") }}
{% endblock %}
