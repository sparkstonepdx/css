{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Button" %}
{% set slug = "button" %}

{% block content %}
<h1>Button</h1>
<p class="lede">
  Buttons carry the primary color by default. In the classless build every
  <code>button</code>, <code>[type="button"]</code>, <code>[type="submit"]</code>,
  <code>[type="reset"]</code> and <code>[role="button"]</code> gets the same treatment.
</p>

{{ m.classes([
  ["btn", "Base button"],
  ["btn-primary", "Primary color fill (the default look)"],
  ["btn-secondary", "Transparent with a border"],
  ["btn-ghost", "No border, no fill"],
  ["btn-neutral", "Fills from the fallback color instead of the theme color"],
  ["btn-disabled", "Greyscale, for elements without a disabled attribute"]
]) }}

<h2>Basic</h2>
{% set classless %}
<button>Button</button>
<a href="#" role="button">Link button</a>
{% endset %}
{% set classes %}
<button class="btn">Button</button>
<a href="#" class="btn">Link button</a>
{% endset %}
{{ m.demo("btn-basic", classless, classes) }}

<h2>Variants</h2>
{% set classless %}
<button class="primary">Primary</button>
<button class="secondary">Secondary</button>
<button class="ghost">Ghost</button>
<button class="contrast">Contrast</button>
{% endset %}
{% set classes %}
<button class="btn btn-primary">Primary</button>
<button class="btn btn-secondary">Secondary</button>
<button class="btn btn-ghost">Ghost</button>
<button class="btn btn-neutral">Contrast</button>
{% endset %}
{{ m.demo("btn-variants", classless, classes) }}
{{ m.classless_note("the modifier classes are bare (<code>.primary</code>, <code>.contrast</code>) because they only apply to elements the theme already styles.") }}

<h2>Disabled</h2>
{% set classless %}
<button disabled>Disabled</button>
<button class="disabled">Looks disabled</button>
{% endset %}
{% set classes %}
<button class="btn" disabled>Disabled</button>
<button class="btn btn-disabled">Looks disabled</button>
{% endset %}
{{ m.demo("btn-disabled", classless, classes) }}

<h2>Unstyling a button</h2>
{% set classless %}
<div>
  <p>Read more about <button class="semantic" style="text-decoration: underline">this topic</button>.</p>
</div>
{% endset %}
{% set classes %}
<div class="prose">
  <p>Read more about <button class="semantic" style="text-decoration: underline">this topic</button>.</p>
</div>
{% endset %}
{{ m.demo("btn-semantic", classless, classes) }}
<p>
  <small>
    <code>.semantic</code> unsets every style so a button can sit inside a sentence.
    It works in both builds.
  </small>
</p>

<h2>Input buttons</h2>
{% set classless %}
<input type="submit" value="Submit" />
<input type="reset" value="Reset" />
{% endset %}
{% set classes %}
<input type="submit" class="btn" value="Submit" />
<input type="reset" class="btn" value="Reset" />
{% endset %}
{{ m.demo("btn-inputs", classless, classes) }}
<p>
  <small>
    Button-type inputs are styled as buttons in both builds. In 1.x the classless
    build also applied the text-field rules to them, so they stretched to the full
    width and carried a bottom margin.
  </small>
</p>
{# composition #}
<h2 id="composition">Composition</h2>
<p>
  Common ways to put this together with other components. The general rules are on
  <a href="./composition.html">Composition</a>.
</p>

<h3>One primary action per region</h3>
<p>A hero with one filled button, and a confirm row where the safe choice is secondary.</p>
{% set classless %}
<div style="display: grid; gap: var(--padding)">
<section class="prose" style="max-width: 40rem">
  <h1>Software your business actually runs on</h1>
  <p>Intake, scheduling and the site that feeds them, built and looked after by one person.</p>
  <a href="#" class="btn">Book a call</a>
  <a href="#" class="btn btn-ghost">See the work</a>
</section>
<article class="card prose">
  <h3>Cancel this booking?</h3>
  <p>The time goes back on the calendar for someone else.</p>
  <footer class="card-actions flex" style="justify-content: end">
    <button class="btn btn-secondary">Keep it</button>
    <button class="btn">Cancel booking</button>
  </footer>
</article>
</div>
{% endset %}
{{ m.demo("button-comp-1", classless) }}
<ul>
  <li><strong>Actions:</strong> one <code>.btn</code> per region; the alternative is <code>.btn-ghost</code> or <code>.btn-secondary</code> so the eye has one place to land.</li>
  <li><strong>Layout:</strong> nothing has a margin outside its own box, so the two regions are spaced by the grid that holds them.</li>
  <li><strong>Surface:</strong> <code>.card-actions</code> gives the card's buttons their own rule and spacing at the end of the card.</li>
</ul>

<h3>Equal choices</h3>
<p>When no option is the main one, none of them is filled.</p>
{% set classless %}
<div class="prose">
  <h3>Add to your calendar</h3>
</div>
<div class="flex" style="flex-wrap: wrap">
  <a href="#" class="btn btn-secondary">Google</a>
  <a href="#" class="btn btn-secondary">Apple / Outlook</a>
  <a href="#" class="btn btn-ghost">Download .ics</a>
</div>
{% endset %}
{{ m.demo("button-comp-2", classless) }}
<ul>
  <li><strong>Layout:</strong> a wrapping <code>.flex</code> row, so on a phone the buttons fall to a second line instead of shrinking.</li>
</ul>
{% endblock %}
