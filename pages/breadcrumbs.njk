{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Breadcrumbs" %}
{% set slug = "breadcrumbs" %}

{% block content %}
<h1>Breadcrumbs</h1>
<p class="lede">
  The trail back up the hierarchy.
  <a href="https://kobalte.dev/docs/core/components/breadcrumbs" target="_blank" rel="noreferrer">Kobalte's Breadcrumbs</a>
  wraps your own <code>&lt;ol&gt;</code> and marks the current page with
  <code>aria-current</code> and <code>data-current</code>, which is what the styling
  keys on.
</p>

{{ m.alpha() }}

{{ m.classes([
  ["breadcrumbs", "The nav: lays out its ol, and marks the current page"],
  ["breadcrumbs-separator", "The character between items"]
]) }}

<h2>Basic</h2>
{% set classless %}
<nav class="breadcrumbs" aria-label="Breadcrumbs">
  <ol>
    <li><a href="#" class="link">Docs</a> <span class="breadcrumbs-separator">/</span></li>
    <li><a href="#" class="link">Components</a> <span class="breadcrumbs-separator">/</span></li>
    <li><span aria-current="page">Breadcrumbs</span></li>
  </ol>
</nav>
{% endset %}
{% set kobalte_markup %}
<nav class="breadcrumbs" aria-label="Breadcrumbs">
  <ol>
    <li><a href="#" class="link">Docs</a> <span class="breadcrumbs-separator" aria-hidden="true">/</span></li>
    <li><a href="#" class="link">Components</a> <span class="breadcrumbs-separator" aria-hidden="true">/</span></li>
    <li><span data-current aria-current="page">Breadcrumbs</span></li>
  </ol>
</nav>
{% endset %}
{% set kobalte %}
import { Breadcrumbs } from "@kobalte/core/breadcrumbs";

<Breadcrumbs class="breadcrumbs">
  <ol>
    <li>
      <Breadcrumbs.Link href="/docs" class="link">Docs</Breadcrumbs.Link>
      <Breadcrumbs.Separator class="breadcrumbs-separator" />
    </li>
    <li>
      <Breadcrumbs.Link current>Breadcrumbs</Breadcrumbs.Link>
    </li>
  </ol>
</Breadcrumbs>
{% endset %}
{{ m.demo("breadcrumbs-basic", classless, "", kobalte, kobalte_markup) }}
<p>
  <small>
    Kobalte's root is a <code>&lt;nav&gt;</code> with an <code>aria-label</code> and no
    role, which page landmarks also have, so it takes <code>.breadcrumbs</code> by
    hand. Everything below it, including the current page, styles itself.
  </small>
</p>
{% endblock %}
