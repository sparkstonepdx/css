{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Prose" %}
{% set slug = "prose" %}

{% block content %}
<h1>Prose</h1>
<p class="lede">
  Long-form content: paragraphs, headings, lists, quotes, rules and code. The
  classless build styles these elements everywhere. The class build scopes them
  to <code>.prose</code>, so a paragraph inside a component keeps its own spacing.
</p>

{{ m.classes([
  ["prose", "Styles p, h1 to h6, ul, ol, li, blockquote, hr, code, pre, samp and kbd inside it"],
  ["kbd", "Key cap, usable outside .prose"]
]) }}

<h2>Headings and paragraphs</h2>
{% set classless %}
<div>
  <h1>Heading one</h1>
  <h2>Heading two</h2>
  <h3>Heading three</h3>
  <p>Body text sits at 18px with a 1rem bottom margin.</p>
</div>
{% endset %}
{% set classes %}
<div class="prose">
  <h1>Heading one</h1>
  <h2>Heading two</h2>
  <h3>Heading three</h3>
  <p>Body text sits at 18px with a 1rem bottom margin.</p>
</div>
{% endset %}
{{ m.demo("prose-headings", classless, classes) }}

<h2>Lists, quotes and rules</h2>
{% set classless %}
<div>
  <ul>
    <li>First item</li>
    <li>Second item</li>
  </ul>
  <blockquote>A quote gets a thick left border in the theme color.</blockquote>
  <hr />
  <ol>
    <li>Ordered one</li>
    <li>Ordered two</li>
  </ol>
</div>
{% endset %}
{% set classes %}
<div class="prose">
  <ul>
    <li>First item</li>
    <li>Second item</li>
  </ul>
  <blockquote>A quote gets a thick left border in the theme color.</blockquote>
  <hr />
  <ol>
    <li>Ordered one</li>
    <li>Ordered two</li>
  </ol>
</div>
{% endset %}
{{ m.demo("prose-lists", classless, classes) }}

<h2>Code</h2>
{% set classless %}
<div>
  <p>Inline <code>code</code> and <samp>samp</samp> sit on a raised surface.</p>
  <pre><code>const theme = "@sparkstone/css";
console.log(theme);</code></pre>
</div>
{% endset %}
{% set classes %}
<div class="prose">
  <p>Inline <code>code</code> and <samp>samp</samp> sit on a raised surface.</p>
  <pre><code>const theme = "@sparkstone/css";
console.log(theme);</code></pre>
</div>
{% endset %}
{{ m.demo("prose-code", classless, classes) }}
{# composition #}
<h2 id="composition">Composition</h2>
<p>
  Common ways to put this together with other components. The general rules are on
  <a href="./composition.html">Composition</a>.
</p>

<h3>Article page</h3>
<p>A long-form page: a heading, a one-line summary under it, body copy with a pull quote, and a closing call to action. One <code>.prose</code> on the article spaces all of it.</p>
{% set classless %}
<article class="prose" style="max-width: 80ch">
  <h1>How we rebuilt the booking flow</h1>
  <p class="text-secondary">Three weeks, one form, and half the drop-off.</p>
  <p>The old flow asked for everything up front. Most people left at the second screen.</p>
  <blockquote>We stopped asking for anything we could find out later.</blockquote>
  <h2>What changed</h2>
  <ul>
    <li>One screen instead of four</li>
    <li>Optional fields moved after the booking</li>
  </ul>
  <h2>Have a form like this?</h2>
  <p>A short call is the quickest way to find out what to cut.</p>
  <a href="#" class="btn">Book a call</a>
</article>
{% endset %}
{{ m.demo("prose-comp-1", classless) }}
<ul>
  <li><strong>Text:</strong> the summary is <code>.text-secondary</code>, so it reads as a lead-in rather than a second heading.</li>
  <li><strong>Actions:</strong> the button is the only filled thing on the page, at the end, where a reader who finished is ready to act.</li>
</ul>
{% endblock %}
