{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Alert" %}
{% set slug = "alert" %}

{% block content %}
<h1>Alert</h1>
<p class="lede">
  A short, important message.
  <a href="https://kobalte.dev/docs/core/components/alert" target="_blank" rel="noreferrer">Kobalte's Alert</a>
  is one element with <code>role="alert"</code>, which the Kobalte layer binds, so
  it needs no class at all.
</p>

{{ m.alpha() }}

{{ m.classes([
  ["alert", "The message box"],
  ["alert-error", "Recolours it with --error"]
]) }}

<h2>Basic</h2>
{% set classless %}
<div class="alert" role="alert">Your changes have been saved.</div>
<div class="alert alert-error" role="alert">We could not reach the server.</div>
{% endset %}
{% set kobalte_markup %}
<div role="alert">Your changes have been saved.</div>
<div role="alert" class="alert-error">We could not reach the server.</div>
{% endset %}
{% set kobalte %}
import { Alert } from "@kobalte/core/alert";

<Alert>Your changes have been saved.</Alert>
<Alert class="alert-error">We could not reach the server.</Alert>
{% endset %}
{{ m.demo("alert-basic", classless, "", kobalte, kobalte_markup) }}
<p>
  <small>
    There is no info, success or warning variant yet. The framework derives
    everything from one <code>--primary</code> plus <code>--error</code>, and
    those variants need tokens it does not have.
  </small>
</p>
{% endblock %}
