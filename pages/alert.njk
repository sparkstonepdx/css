{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Alert" %}
{% set slug = "alert" %}

{% block content %}
<h1>Alert</h1>
<p class="lede">
  A short, important message.
  <a href="https://kobalte.dev/docs/core/components/alert" target="_blank" rel="noreferrer">Kobalte's Alert</a>
  is one element with <code>role="alert"</code>, which the Kobalte layer binds, so
  it needs no class at all.
</p>

{{ m.alpha() }}

{{ m.classes([
  ["alert", "The message box"],
  ["alert-error", "Recolours it with --error"]
]) }}

<h2>Basic</h2>
{% set classless %}
<div class="alert" role="alert">Your changes have been saved.</div>
<div class="alert alert-error" role="alert">We could not reach the server.</div>
{% endset %}
{% set kobalte_markup %}
<div role="alert">Your changes have been saved.</div>
<div role="alert" class="alert-error">We could not reach the server.</div>
{% endset %}
{% set kobalte %}
import { Alert } from "@kobalte/core/alert";

<Alert>Your changes have been saved.</Alert>
<Alert class="alert-error">We could not reach the server.</Alert>
{% endset %}
{{ m.demo("alert-basic", classless, "", kobalte, kobalte_markup) }}
<p>
  <small>
    There is no info, success or warning variant yet. The framework derives
    everything from one <code>--primary</code> plus <code>--error</code>, and
    those variants need tokens it does not have.
  </small>
</p>
{# composition #}
<h2 id="composition">Composition</h2>
<p>
  Common ways to put this together with other components. The general rules are on
  <a href="./composition.html">Composition</a>.
</p>

<h3>At the top of a form</h3>
<p>A form-level error goes above the fields, inside the card, so it is read before the fields are.</p>
{% set classless %}
<form class="card">
  <div class="alert alert-error" role="alert">We could not send your message. Try again in a minute.</div>
  <label class="label">
    <p>Email</p>
    <input class="input" type="email" />
  </label>
  <footer class="card-actions flex" style="justify-content: end">
    <button class="btn">Send</button>
  </footer>
</form>
{% endset %}
{{ m.demo("alert-comp-1", classless) }}
<ul>
  <li><strong>Boundary:</strong> <code>.alert-error</code> is an error boundary, so its border, surface and text all take the error colour from one class.</li>
  <li><strong>Spacing:</strong> the alert carries a <code>1rem</code> bottom margin like a field, so it stacks into the form with no wrapper.</li>
</ul>

<h3>A toast after a form is sent</h3>
<p>The form clears and a toast confirms it, out of the way of the next thing the visitor does.</p>
{% set classless %}
<form class="card" style="max-width: 24rem">
  <label class="label"><p>Email</p><input class="input" type="email" /></label>
  <button class="btn">Subscribe</button>
</form>
<ul class="toast" style="position: static; max-width: 22rem; margin-top: var(--padding)">
  <li class="alert" role="status">
    <span><span class="toast-title">Subscribed</span><br /><span class="toast-description">Check your inbox to confirm.</span></span>
  </li>
</ul>
{% endset %}
{{ m.demo("alert-comp-2", classless) }}
<ul>
  <li><strong>Surface:</strong> each message is an <code>.alert</code>, so a failure is <code>.alert-error</code> with no toast-specific class.</li>
  <li><strong>Layout:</strong> <code>.toast</code> is fixed to the corner; it is static here so it shows in the preview.</li>
</ul>
{% endblock %}
