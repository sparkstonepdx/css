{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Tooltip" %}
{% set slug = "tooltip" %}

{% block content %}
<h1>Tooltip</h1>
<p class="lede">
  A small bubble of explanatory text. The class paints the bubble and nothing
  else: a CSS-only tooltip anchors with a pseudo-element, and
  <a href="https://kobalte.dev/docs/core/components/tooltip" target="_blank" rel="noreferrer">Kobalte</a>
  positions a portaled <code>Content</code> with its popper.
</p>

{{ m.alpha() }}

{{ m.classes([
  ["tooltip-content", "The bubble: inverted surface, small text"],
  ["tooltip-arrow", "Colour for Kobalte's arrow, which draws itself in currentColor"]
]) }}

<h2>Basic</h2>
{% set classless %}
<button class="btn">Save</button>
<span class="tooltip-content" style="display: inline-block; margin-left: 0.5rem">Saves and closes</span>
{% endset %}
{% set kobalte_markup %}
<button class="btn" aria-describedby="tip">Save</button>
<div role="tooltip" id="tip" data-expanded style="display: inline-block; margin-left: 0.5rem">Saves and closes</div>
{% endset %}
{% set kobalte %}
import { Tooltip } from "@kobalte/core/tooltip";

<Tooltip>
  <Tooltip.Trigger class="btn">Save</Tooltip.Trigger>
  <Tooltip.Portal>
    <Tooltip.Content>
      Saves and closes
      <Tooltip.Arrow />
    </Tooltip.Content>
  </Tooltip.Portal>
</Tooltip>
{% endset %}
{{ m.demo("tooltip-basic", classless, "", kobalte, kobalte_markup) }}
<p>
  <small>
    The demo places the bubble inline so it is visible without a hover. In an app
    Kobalte's popper positions it, and <code>data-expanded</code> tells you when it
    is open if you want to animate it.
  </small>
</p>
{# composition #}
<h2 id="composition">Composition</h2>
<p>
  Common ways to put this together with other components. The general rules are on
  <a href="./composition.html">Composition</a>.
</p>

<h3>Labelling an icon button</h3>
<p>A toolbar of short buttons, with the tooltip naming the one under the pointer.</p>
{% set classless %}
<div class="flex" style="align-items: center; gap: calc(var(--padding) / 4)">
  <button class="btn btn-ghost" aria-label="Bold"><strong>B</strong></button>
  <button class="btn btn-ghost" aria-label="Italic"><i>I</i></button>
  <span style="position: relative; display: inline-block">
    <button class="btn btn-ghost" aria-label="Link" aria-describedby="ctip">Link</button>
    <span class="tooltip-content" role="tooltip" id="ctip" style="position: absolute; left: 50%; top: 100%; transform: translateX(-50%); margin-top: 0.25rem; white-space: nowrap">Add a link (Ctrl K)</span>
  </span>
</div>
{% endset %}
{{ m.demo("tooltip-comp-1", classless) }}
<ul>
  <li><strong>Surface:</strong> the tooltip is the inverse of the page, so it reads over any surface it lands on.</li>
  <li><strong>Layout:</strong> <code>.tooltip-content</code> only paints; where it sits is up to whatever shows it.</li>
</ul>
{% endblock %}
