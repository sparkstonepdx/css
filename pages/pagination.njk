{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Pagination" %}
{% set slug = "pagination" %}

{% block content %}
<h1>Pagination</h1>
<p class="lede">
  A row of page buttons. Each button is a <a href="./button.html">btn</a>; this
  lays them out and fills in the current one, which
  <a href="https://kobalte.dev/docs/core/components/pagination" target="_blank" rel="noreferrer">Kobalte's Pagination</a>
  marks with <code>aria-current</code> and <code>data-current</code>.
</p>

{{ m.alpha() }}

{{ m.classes([
  ["pagination", "The nav: lays out its ul, and fills the current page button"],
  ["pagination-ellipsis", "The gap marker between ranges"]
]) }}

<h2>Basic</h2>
{% set classless %}
<nav class="pagination" aria-label="Pages">
  <ul>
    <li><button class="btn btn-secondary">Previous</button></li>
    <li><button class="btn btn-secondary">1</button></li>
    <li><button class="btn btn-secondary" aria-current="page">2</button></li>
    <li><span class="pagination-ellipsis">…</span></li>
    <li><button class="btn btn-secondary">9</button></li>
    <li><button class="btn btn-secondary">Next</button></li>
  </ul>
</nav>
{% endset %}
{% set kobalte_markup %}
<nav class="pagination" aria-label="Pages">
  <ul>
    <li><button class="btn btn-secondary">Previous</button></li>
    <li><button class="btn btn-secondary">1</button></li>
    <li><button class="btn btn-secondary" data-current aria-current="page">2</button></li>
    <li><span class="pagination-ellipsis">…</span></li>
    <li><button class="btn btn-secondary">9</button></li>
    <li><button class="btn btn-secondary">Next</button></li>
  </ul>
</nav>
{% endset %}
{% set kobalte %}
import { Pagination } from "@kobalte/core/pagination";

<Pagination
  class="pagination"
  count={9}
  page={page()}
  onPageChange={setPage}
  itemComponent={props => (
    <Pagination.Item class="btn btn-secondary" page={props.page}>
      {props.page}
    </Pagination.Item>
  )}
  ellipsisComponent={() => (
    <Pagination.Ellipsis class="pagination-ellipsis">…</Pagination.Ellipsis>
  )}
>
  <Pagination.Previous class="btn btn-secondary">Previous</Pagination.Previous>
  <Pagination.Items />
  <Pagination.Next class="btn btn-secondary">Next</Pagination.Next>
</Pagination>
{% endset %}
{{ m.demo("pagination-basic", classless, "", kobalte, kobalte_markup) }}
{# composition #}
<h2 id="composition">Composition</h2>
<p>
  Common ways to put this together with other components. The general rules are on
  <a href="./composition.html">Composition</a>.
</p>

<h3>Under a list</h3>
<p>A list of entries, then the page row, centred under it.</p>
{% set classless %}
<div style="display: grid; gap: var(--padding)">
  <a href="#" class="semantic card prose"><h3 class="link">Entry one</h3><p>A sentence about it.</p></a>
  <a href="#" class="semantic card prose"><h3 class="link">Entry two</h3><p>A sentence about it.</p></a>
</div>
<nav class="pagination" aria-label="Pages" style="display: flex; justify-content: center; margin-top: var(--padding)">
  <ul>
    <li><button class="btn btn-secondary">Previous</button></li>
    <li><button class="btn btn-secondary">1</button></li>
    <li><button class="btn btn-secondary" aria-current="page">2</button></li>
    <li><button class="btn btn-secondary">3</button></li>
    <li><button class="btn btn-secondary">Next</button></li>
  </ul>
</nav>
{% endset %}
{{ m.demo("pagination-comp-1", classless) }}
<ul>
  <li><strong>Spacing:</strong> nothing sets a top margin, so the row takes <code>margin-top: var(--padding)</code> to clear the list.</li>
  <li><strong>Actions:</strong> every page is <code>.btn-secondary</code>; the current one is filled, so the row has exactly one filled button.</li>
</ul>
{% endblock %}
