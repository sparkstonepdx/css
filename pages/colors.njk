{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Colors" %}
{% set slug = "colors" %}

{% block content %}
<h1>Colors</h1>
<p class="lede">
  A few inputs, set anywhere, and a small set of colours derived from them on
  every element. Pick any colour, put it on any element, and everything inside
  re-themes around it.
</p>

{{ m.alpha() }}

<h2>Inputs</h2>
{{ m.classes([
  ["--primary", "The brand colour. Its own hue and chroma are kept; only the lightness is pinned per role"],
  ["--secondary", "Links. Defaults to the primary rotated 180 degrees"],
  ["--neutral", "What text and surfaces are tinted with. Defaults to the primary"],
  ["--error", "Invalid fields, error text, error alerts"]
]) }}

<h2>Live preview</h2>
<p>Change these and every page on this site updates. Values persist for the session.</p>
<form class="flex" style="flex-wrap: wrap; align-items: end">
  <label>
    <p>Primary</p>
    <input type="color" id="base-color-picker" />
  </label>
  <label>
    <p>Secondary</p>
    <input type="color" id="accent-color-picker" />
  </label>
  <label>
    <p>Error</p>
    <input type="color" id="error-color-picker" />
  </label>
</form>

<h2>Derived colours</h2>
<p>
  Components read these, never the inputs. Text colours are solid, so their
  contrast never depends on what sits behind them. Surfaces and rules are a tinted
  mid-tone at partial opacity, so they carry the theme's colour, stack when
  nested, and flip with the scheme on their own.
</p>
<div class="token-grid">
  {% for t in [
    ["--bg", "Page"], ["--surface", "Raised, 30%"], ["--surface-strong", "Raised, 63%"], ["--divider", "Rules, 30%"],
    ["--fg", "Text"], ["--fg-muted", "Secondary text"], ["--fg-faint", "Disabled text"],
    ["--line", "Borders, focus, fills"], ["--primary-text", "Brand text"], ["--primary-fill", "Filled button"],
    ["--on-primary-fill", "Text on it"], ["--link", "Links"]
  ] %}
    <div class="token">
      <span class="token-swatch" style="background: var({{ t[0] }})"></span>
      <code>{{ t[0] }}</code>
      <small>{{ t[1] }}</small>
    </div>
  {% endfor %}
</div>

<h2>Apply anywhere</h2>
<p>
  Set an input on any element and add <code>.retheme</code>, and everything inside
  re-themes around it. The class marks where colours are derived again; between
  boundaries they are simply inherited, so you can also override a single derived
  colour, such as <code>--surface</code>, for a whole subtree. These are nested
  sections, each setting a single input:
</p>
{% set classless %}
<section class="card-border retheme" style="--primary: tomato">
  <p><code>--primary: tomato</code></p>
  <button class="btn">Save</button>
  <input class="input" placeholder="A field" style="margin: 0.75rem 0" />
  <section class="card-border retheme" style="--primary: #0a7d6b">
    <p><code>--primary: #0a7d6b</code>, one level down</p>
    <button class="btn btn-secondary">Cancel</button>
    <a href="#" class="link">A link</a>
    <section class="card-border disabled" style="margin-top: 0.75rem">
      <p><code>.disabled</code>: one declaration, <code>--chroma: 0</code></p>
      <button class="btn">Save</button>
    </section>
  </section>
</section>
{% endset %}
{{ m.demo("colors-anywhere", classless) }}

<h2>Brand colours keep their character</h2>
<p>
  Only the lightness is pinned per role. A muted brand stays muted and a grey
  one stays grey, where 2.x kept only the hue and replaced the chroma. Chroma is
  still capped per role, so a vivid colour at a very light or very dark lightness
  stays in gamut.
</p>
{% set classless %}
<div class="flex" style="flex-wrap: wrap">
  {% for c in ["rebeccapurple", "#c2410c", "#6b7c59", "slategrey", "#1d4ed8"] %}
    <div class="retheme" style="--primary: {{ c }}; display: flex; flex-direction: column; gap: 0.5rem; align-items: start">
      <button class="btn">{{ c }}</button>
      <button class="btn btn-secondary">Secondary</button>
      <span class="badge">Badge</span>
    </div>
  {% endfor %}
</div>
{% endset %}
{{ m.demo("colors-brands", classless) }}
{% endblock %}
