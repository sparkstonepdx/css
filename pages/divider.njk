{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Divider" %}
{% set slug = "divider" %}

{% block content %}
<h1>Divider</h1>
<p class="lede">
  A rule between blocks of content.
  <a href="https://kobalte.dev/docs/core/components/separator" target="_blank" rel="noreferrer">Kobalte's Separator</a>
  renders <code>role="separator"</code> with its orientation on it, so it needs no
  class.
</p>

{{ m.alpha() }}

{{ m.classes([
  ["divider", "A horizontal rule with vertical margins"],
  ["divider-vertical", "A vertical rule, for a flex row"]
]) }}

<h2>Basic</h2>
{% set classless %}
<div>Above the rule.</div>
<hr class="divider" />
<div>Below it.</div>
<div class="flex" style="align-items: center">
  <span>Left</span>
  <hr class="divider divider-vertical" style="height: 1.5rem" />
  <span>Right</span>
</div>
{% endset %}
{% set kobalte_markup %}
<div>Above the rule.</div>
<hr role="separator" data-orientation="horizontal" />
<div>Below it.</div>
<div class="flex" style="align-items: center">
  <span>Left</span>
  <hr role="separator" data-orientation="vertical" style="height: 1.5rem" />
  <span>Right</span>
</div>
{% endset %}
{% set kobalte %}
import { Separator } from "@kobalte/core/separator";

<Separator />
<Separator orientation="vertical" />
{% endset %}
{{ m.demo("divider-basic", classless, "", kobalte, kobalte_markup) }}
<p>
  <small>
    A bare <code>&lt;hr&gt;</code> is prose: it takes the typography rule inside
    <code>.prose</code> and the tight rule inside a <code>.menu</code>.
    <code>.divider</code> is the standalone one.
  </small>
</p>
{# composition #}
<h2 id="composition">Composition</h2>
<p>
  Common ways to put this together with other components. The general rules are on
  <a href="./composition.html">Composition</a>.
</p>

<h3>Between groups in a toolbar</h3>
<p>A vertical divider splits a row of actions into groups.</p>
{% set classless %}
<div class="flex" style="align-items: center; gap: calc(var(--padding) / 4)">
  <button class="btn btn-ghost">Undo</button>
  <button class="btn btn-ghost">Redo</button>
  <div class="divider divider-vertical" style="height: 1.5rem; margin: 0 calc(var(--padding) / 2)"></div>
  <button class="btn btn-ghost">Share</button>
  <button class="btn btn-secondary">Export</button>
</div>
{% endset %}
{{ m.demo("divider-comp-1", classless) }}
<ul>
  <li><strong>Layout:</strong> a vertical divider takes its height from you; give it about a line of text.</li>
</ul>

<h3>Between a page and its footer</h3>
<p>A horizontal divider starts the footer without boxing it.</p>
{% set classless %}
<p>The last paragraph of the page.</p>
<footer>
  <hr class="divider" />
  <p class="text-secondary"><small>A short line of small print.</small></p>
</footer>
{% endset %}
{{ m.demo("divider-comp-2", classless) }}
<ul>
  <li><strong>Surface:</strong> <code>.divider</code> is the same colour as a <code>.card-border</code> border, so it belongs to the same family.</li>
</ul>
{% endblock %}
