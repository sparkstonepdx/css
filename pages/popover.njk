{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Popover" %}
{% set slug = "popover" %}

{% block content %}
<h1>Popover</h1>
<p class="lede">
  A floating panel with content in it, as opposed to a menu of rows.
  <a href="https://kobalte.dev/docs/core/components/popover" target="_blank" rel="noreferrer">Kobalte's Popover</a>
  renders its content as <code>role="dialog"</code> and positions it with a popper;
  these classes only paint.
</p>

{{ m.alpha() }}

{{ m.classes([
  ["popover-content", "The panel: raised surface, border, shadow"],
  ["popover-title", "Its heading"],
  ["popover-description", "Muted body text"]
]) }}

<h2>Basic</h2>
{% set classless %}
<div class="popover-content">
  <h2 class="popover-title">Share this page</h2>
  <p class="popover-description">Anyone with the link can read it.</p>
</div>
{% endset %}
{% set kobalte_markup %}
<div role="dialog" data-expanded>
  <h2 class="popover-title">Share this page</h2>
  <p class="popover-description">Anyone with the link can read it.</p>
</div>
{% endset %}
{% set kobalte %}
import { Popover } from "@kobalte/core/popover";

<Popover>
  <Popover.Trigger class="btn">Share</Popover.Trigger>
  <Popover.Portal>
    <Popover.Content>
      <Popover.Title class="popover-title">Share this page</Popover.Title>
      <Popover.Description class="popover-description">
        Anyone with the link can read it.
      </Popover.Description>
      <Popover.CloseButton class="btn btn-ghost">Close</Popover.CloseButton>
    </Popover.Content>
  </Popover.Portal>
</Popover>
{% endset %}
{{ m.demo("popover-basic", classless, "", kobalte, kobalte_markup) }}
<p>
  <small>
    <code>Dialog.Content</code> is also <code>role="dialog"</code>, and Kobalte marks
    them the same way, so a Kobalte dialog picks up this panel too. Add
    <code>.dialog-box</code> to it if you want the modal sizing as well.
  </small>
</p>
{# composition #}
<h2 id="composition">Composition</h2>
<p>
  Common ways to put this together with other components. The general rules are on
  <a href="./composition.html">Composition</a>.
</p>

<h3>Share with a field</h3>
<p>A popover holding a title, a line, and a field with a copy button.</p>
{% set classless %}
<div class="popover-content" style="max-width: 22rem">
  <h2 class="popover-title">Share this page</h2>
  <p class="popover-description">Anyone with the link can read it.</p>
  <div class="flex" style="align-items: end; margin-top: calc(var(--padding) / 2)">
    <input class="input" value="https://example.com/page" readonly style="flex: 1; margin: 0" />
    <button class="btn btn-secondary">Copy</button>
  </div>
</div>
{% endset %}
{{ m.demo("popover-comp-1", classless) }}
<ul>
  <li><strong>Controls:</strong> a field in a popover drops its bottom margin; the panel's padding is the spacing.</li>
</ul>
{% endblock %}
