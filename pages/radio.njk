{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Radio" %}
{% set slug = "radio" %}

{% block content %}
<h1>Radio</h1>
<p class="lede">
  Radios are styled by their wrapping label, which also gives you the card
  variant for bigger choice targets.
</p>

{{ m.classes([
  ["radio", "Custom radio dot"],
  ["label", "On the wrapping label: row layout with a gap"],
  ["block", "On the wrapping label: padded, bordered card that highlights when selected"]
]) }}

<h2>Basic</h2>
{% set classless %}
<label>
  <input type="radio" name="plan" checked />
  Monthly
</label>
<label>
  <input type="radio" name="plan" />
  Yearly
</label>
{% endset %}
{% set classes %}
<label class="label">
  <input type="radio" name="plan" class="radio" checked />
  Monthly
</label>
<label class="label">
  <input type="radio" name="plan" class="radio" />
  Yearly
</label>
{% endset %}
{{ m.demo("radio-basic", classless, classes) }}

<h2>Card radios</h2>
{% set classless %}
<label class="block">
  <input type="radio" name="tier" checked />
  Hobby
</label>
<label class="block">
  <input type="radio" name="tier" />
  Team
</label>
{% endset %}
{% set classes %}
<label class="label block">
  <input type="radio" name="tier" class="radio" checked />
  Hobby
</label>
<label class="label block">
  <input type="radio" name="tier" class="radio" />
  Team
</label>
{% endset %}
{{ m.demo("radio-block", classless, classes) }}
{# composition #}
<h2 id="composition">Composition</h2>
<p>
  Common ways to put this together with other components. The general rules are on
  <a href="./composition.html">Composition</a>.
</p>

<h3>Choice cards</h3>
<p>Each option is a bordered block with a title and a line; the chosen one is highlighted.</p>
{% set classless %}
<fieldset class="fieldset">
  <legend class="fieldset-legend">Plan</legend>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: var(--padding)">
    <label class="label block">
      <input type="radio" name="cplan" class="radio" checked />
      <span><strong>Monthly</strong><br /><small class="text-secondary">Pay as you go, cancel any time</small></span>
    </label>
    <label class="label block">
      <input type="radio" name="cplan" class="radio" />
      <span><strong>Yearly</strong><br /><small class="text-secondary">Two months free</small></span>
    </label>
  </div>
</fieldset>
{% endset %}
{{ m.demo("radio-comp-1", classless) }}
<ul>
  <li><strong>Controls:</strong> <code>.label.block</code> draws the border and fills the checked option with <code>--surface</code>; the radio still does the work.</li>
  <li><strong>Layout:</strong> a grid makes the options equal widths and stacks them on a phone.</li>
</ul>

<h3>A short list of options</h3>
<p>Two or three options with a line each, stacked in a fieldset.</p>
{% set classless %}
<fieldset class="fieldset">
  <legend class="fieldset-legend">Delivery</legend>
  <label class="label"><input type="radio" name="cdel" class="radio" checked /> Standard, 3 to 5 days</label>
  <label class="label"><input type="radio" name="cdel" class="radio" /> Express, next day</label>
</fieldset>
{% endset %}
{{ m.demo("radio-comp-2", classless) }}
<ul>
  <li><strong>Controls:</strong> a radio inside a <code>.label</code> lays out as a row; the legend names the choice once, so each option only says what differs.</li>
</ul>
{% endblock %}
