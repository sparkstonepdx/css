{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Segmented control" %}
{% set slug = "segmented" %}

{% block content %}
<h1>Segmented control</h1>
<p class="lede">
  One control, a few exclusive choices.
  <a href="https://kobalte.dev/docs/core/components/segmented-control" target="_blank" rel="noreferrer">Kobalte's SegmentedControl</a>
  builds it from a hidden radio per item plus an indicator it positions inline.
</p>

{{ m.alpha() }}

{{ m.classes([
  ["segmented", "The track holding the items"],
  ["segmented-item", "One choice. Checked state comes from its radio, data-checked, or segmented-item-active"],
  ["segmented-indicator", "The sliding highlight. Leave it out and the checked item paints its own"]
]) }}

<h2>Basic</h2>
{% set classless %}
<div class="segmented">
  <label class="segmented-item"><input type="radio" name="view" checked /> List</label>
  <label class="segmented-item"><input type="radio" name="view" /> Board</label>
  <label class="segmented-item"><input type="radio" name="view" /> Calendar</label>
</div>
{% endset %}
{% set kobalte_markup %}
<div class="segmented">
  <div class="segmented-indicator"></div>
  <label class="segmented-item" data-checked><input type="radio" name="kview" checked /> List</label>
  <label class="segmented-item"><input type="radio" name="kview" /> Board</label>
  <label class="segmented-item"><input type="radio" name="kview" /> Calendar</label>
</div>
{% endset %}
{% set kobalte %}
import { SegmentedControl } from "@kobalte/core/segmented-control";

<SegmentedControl class="segmented" value={view()} onChange={setView}>
  <SegmentedControl.Indicator class="segmented-indicator" />
  <For each={["List", "Board", "Calendar"]}>
    {option => (
      <SegmentedControl.Item value={option} class="segmented-item">
        <SegmentedControl.ItemInput />
        <SegmentedControl.ItemLabel>{option}</SegmentedControl.ItemLabel>
      </SegmentedControl.Item>
    )}
  </For>
</SegmentedControl>
{% endset %}
{{ m.demo("segmented-basic", classless, "", kobalte, kobalte_markup) }}
<p>
  <small>
    None of Kobalte's parts here carry a role, so the classes go on them by hand.
    The checked state is read three ways: the item's own radio, Kobalte's
    <code>data-checked</code>, or <code>.segmented-item-active</code>.
  </small>
</p>
{# composition #}
<h2 id="composition">Composition</h2>
<p>
  Common ways to put this together with other components. The general rules are on
  <a href="./composition.html">Composition</a>.
</p>

<h3>A view switch above results</h3>
<p>The switch sits at the end of the row that holds the result count.</p>
{% set classless %}
<div class="flex" style="justify-content: space-between; align-items: center; flex-wrap: wrap">
  <span class="text-secondary">24 items</span>
  <div class="segmented" role="radiogroup" aria-label="View">
    <label class="segmented-item"><input type="radio" name="cview" checked /> Grid</label>
    <label class="segmented-item"><input type="radio" name="cview" /> List</label>
  </div>
</div>
{% endset %}
{{ m.demo("segmented-comp-1", classless) }}
<ul>
  <li><strong>Controls:</strong> a segmented control is for a choice that changes the view at once. A choice that is submitted with a form belongs in radios or a select.</li>
</ul>
{% endblock %}
