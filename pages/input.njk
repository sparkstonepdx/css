{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Input" %}
{% set slug = "input" %}

{% block content %}
<h1>Input</h1>
<p class="lede">
  Text-like inputs: text, email, password, search, tel, url, number, and the
  date and time family, which get an icon on the trailing edge.
</p>

{{ m.classes([
  ["input", "Full-width field with the shared control surface"],
  ["input-error", "Error color, for when aria-invalid is not available"]
]) }}

<h2>Basic</h2>
{% set classless %}
<input type="text" placeholder="Text" />
<input type="email" placeholder="you@example.com" />
<input type="password" value="hunter2" />
{% endset %}
{% set classes %}
<input type="text" class="input" placeholder="Text" />
<input type="email" class="input" placeholder="you@example.com" />
<input type="password" class="input" value="hunter2" />
{% endset %}
{{ m.demo("input-basic", classless, classes) }}

<h2>Date and time</h2>
{% set classless %}
<input type="date" />
<input type="time" />
<input type="month" />
{% endset %}
{% set classes %}
<input type="date" class="input" />
<input type="time" class="input" />
<input type="month" class="input" />
{% endset %}
{{ m.demo("input-date", classless, classes) }}

<h2>Invalid and disabled</h2>
{% set classless %}
<input type="text" aria-invalid="true" value="Invalid" />
<input type="text" value="Disabled" disabled />
{% endset %}
{% set classes %}
<input type="text" class="input" aria-invalid="true" value="Invalid" />
<input type="text" class="input" value="Disabled" disabled />
{% endset %}
{{ m.demo("input-states", classless, classes) }}
{{ m.classless_note("every <code>input</code> gets this styling except checkbox, radio, range, file, color, and the button types, which are styled as buttons.") }}
{# composition #}
<h2 id="composition">Composition</h2>
<p>
  Common ways to put this together with other components. The general rules are on
  <a href="./composition.html">Composition</a>.
</p>

<h3>Inline sign-up</h3>
<p>A heading, a sentence, one field and a button.</p>
{% set classless %}
<form class="prose">
  <h2>Newsletter</h2>
  <p>A short note when there is something new.</p>
  <div class="flex flip" style="align-items: end; row-gap: 0">
    <label class="label" style="flex: 1">
      <p>Email</p>
      <input class="input" type="email" placeholder="you@example.com" autocomplete="email" />
    </label>
    <button class="btn btn-secondary" style="margin-bottom: calc(1rem * 1.375)">Subscribe</button>
  </div>
</form>
{% endset %}
{{ m.demo("input-comp-1", classless) }}
<ul>
  <li><strong>Spacing:</strong> in the row, the field keeps its <code>1rem</code> bottom margin and the label adds <code>0.375rem</code> of its own. The button takes both, <code>calc(1rem * 1.375)</code>, to line its bottom edge up with the field's.</li>
  <li><strong>Layout:</strong> <code>.flip</code> stacks them on a phone, and <code>row-gap: 0</code> stops the row's gap adding to the margins once stacked.</li>
</ul>

<h3>Search above results</h3>
<p>A search field and a count, then the results.</p>
{% set classless %}
<label class="label">
  <p>Search</p>
  <input class="input" type="search" placeholder="Title or topic" />
</label>
<p class="text-secondary"><small>12 results</small></p>
{% endset %}
{{ m.demo("input-comp-2", classless) }}
<ul>
  <li><strong>Text:</strong> the count is <code>.text-secondary</code> and sits between the field and the results, belonging to neither.</li>
</ul>
{% endblock %}
