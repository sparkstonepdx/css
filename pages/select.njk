{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Select" %}
{% set slug = "select" %}

{% block content %}
<h1>Select</h1>
<p class="lede">
  Single selects get a chevron drawn from <code>--icon-chevron</code>. Multiple
  and sized selects keep the native list, with no icon.
</p>

{{ m.classes([
  ["select", "Full-width select with a chevron"],
  ["select-error", "Error color, for when aria-invalid is not available"]
]) }}

<h2>Basic</h2>
{% set classless %}
<label>
  Environment
  <select>
    <option>Development</option>
    <option>Staging</option>
    <option>Production</option>
  </select>
</label>
{% endset %}
{% set classes %}
<label class="label">
  Environment
  <select class="select">
    <option>Development</option>
    <option>Staging</option>
    <option>Production</option>
  </select>
</label>
{% endset %}
{{ m.demo("select-basic", classless, classes) }}

<h2>Multiple</h2>
{% set classless %}
<select multiple size="3">
  <option>One</option>
  <option>Two</option>
  <option>Three</option>
</select>
{% endset %}
{% set classes %}
<select class="select" multiple size="3">
  <option>One</option>
  <option>Two</option>
  <option>Three</option>
</select>
{% endset %}
{{ m.demo("select-multiple", classless, classes) }}

<h2>With Kobalte</h2>

{{ m.alpha() }}

<p>
  The native <code>&lt;select&gt;</code> above is settled. What follows is not: the
  listbox styling and <code>.menu-selected</code> are new.
</p>
<p>
  <a href="https://kobalte.dev/docs/core/components/select" target="_blank" rel="noreferrer">Kobalte's Select</a>
  is a button plus a listbox, not a native <code>&lt;select&gt;</code>. The Kobalte
  layer gives the trigger the field styling above and styles the listbox and its
  options. <code>Select.Content</code>, the panel around the listbox, has no role
  of its own, so it takes <code>.dropdown-content</code> by hand.
</p>
{% set classless %}
<select class="select">
  <option>Development</option>
  <option>Production</option>
</select>
{% endset %}
{% set kobalte_markup %}
<div>
  <button aria-haspopup="listbox" aria-expanded="true" data-expanded style="margin-bottom: 0.25rem">
    <span>Production</span>
  </button>
  <div class="dropdown-content" data-expanded>
    <ul role="listbox">
      <li role="option">Development</li>
      <li role="option" data-highlighted>Staging</li>
      <li role="option" data-selected aria-selected="true">Production</li>
    </ul>
  </div>
</div>
{% endset %}
{% set kobalte %}
import { Select } from "@kobalte/core/select";

<Select
  options={["Development", "Staging", "Production"]}
  value={env()}
  onChange={setEnv}
  itemComponent={props => (
    <Select.Item item={props.item}>
      <Select.ItemLabel>{props.item.rawValue}</Select.ItemLabel>
    </Select.Item>
  )}
>
  <Select.Trigger>
    <Select.Value>{state => state.selectedOption()}</Select.Value>
  </Select.Trigger>
  <Select.Portal>
    <Select.Content class="dropdown-content">
      <Select.Listbox />
    </Select.Content>
  </Select.Portal>
</Select>
{% endset %}
{{ m.demo("select-kobalte", classless, "", kobalte, kobalte_markup) }}
<p>
  <small>
    Leave out <code>Select.Icon</code>: the field draws its own chevron, the same
    one the native select gets.
  </small>
</p>

<h3>On the class-based build</h3>
<p>
  Put the classes on the parts yourself. The rows follow Kobalte's state without
  any extra classes: a highlighted row matches <code>data-highlighted</code> and a
  selected one <code>aria-selected</code>, which is also what Radix and Ark set.
  For a compact trigger, such as a version switcher, use a button and keep
  <code>Select.Icon</code>; for a form field, use <code>.select</code> and leave
  it out, since the field draws its own chevron.
</p>
{% call m.snippet("select-class-build", "jsx") %}{% raw %}
<Select
  options={versions()}
  optionValue="id"
  optionTextValue="label"
  value={current()}
  onChange={setCurrent}
  itemComponent={props => (
    <Select.Item item={props.item} class="menu-item">
      <Select.ItemLabel>{props.item.rawValue.label}</Select.ItemLabel>
    </Select.Item>
  )}
>
  <Select.Trigger class="btn btn-secondary" aria-label="Version">
    <Select.Value>{state => state.selectedOption().label}</Select.Value>
    <Select.Icon>▾</Select.Icon>
  </Select.Trigger>
  <Select.Portal>
    <Select.Content class="dropdown-content">
      <Select.Listbox class="menu" />
    </Select.Content>
  </Select.Portal>
</Select>
{% endraw %}{% endcall %}

<h3>Disabled</h3>
{% set classless %}
<select class="select" disabled>
  <option>Production</option>
</select>
{% endset %}
{% set kobalte_markup %}
<button aria-haspopup="listbox" aria-expanded="false" disabled data-disabled>
  <span>Production</span>
</button>
{% endset %}
{% set kobalte %}
<Select disabled options={envs} value={env()} onChange={setEnv} itemComponent={Item}>
  <Select.Trigger>
    <Select.Value>{state => state.selectedOption()}</Select.Value>
  </Select.Trigger>
</Select>
{% endset %}
{{ m.demo("select-kobalte-disabled", classless, "", kobalte, kobalte_markup) }}
<p>
  <small>
    The trigger is a form field, so it carries the same bottom margin as an
    <code>.input</code>. That margin is overridden in this demo because the
    listbox sits inline here; in an app the content is portaled and positioned by
    Kobalte's popper, which sets the gap with its <code>gutter</code> prop.
  </small>
</p>
<p>
  <small>
    <code>data-selected</code> marks the chosen option and <code>data-highlighted</code>
    the one under the pointer or caret, so they get different treatments:
    <code>.menu-selected</code> and <code>.menu-active</code>.
  </small>
</p>
{% endblock %}