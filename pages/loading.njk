{% extends "layout.njk" %}
{% import "macros.njk" as m %}
{% set title = "Loading" %}
{% set slug = "loading" %}

{% block content %}
<h1>Loading</h1>
<p class="lede">
  A spinner, drawn in <code>currentColor</code> so it works on any surface and
  inside a button. No component library renders this one: it is a single element
  you place yourself.
</p>

{{ m.alpha() }}

{{ m.classes([
  ["loading", "A spinner. Inherits its colour, sized with width and height"]
]) }}

<h2>Basic</h2>
{% set classless %}
<span class="loading"></span>
<span class="loading" style="width: 2rem; height: 2rem"></span>
<button class="btn"><span class="loading" style="width: 1rem; height: 1rem"></span> Saving</button>
<p><span class="loading" style="width: 0.9rem; height: 0.9rem"></span> Loading results</p>
{% endset %}
{{ m.demo("loading-basic", classless) }}
<p>
  <small>
    The spin stops under <code>prefers-reduced-motion</code>. Pair it with
    <code>aria-busy="true"</code> on the region it is loading, or with visually
    hidden text, since the element itself says nothing.
  </small>
</p>
{# composition #}
<h2 id="composition">Composition</h2>
<p>
  Common ways to put this together with other components. The general rules are on
  <a href="./composition.html">Composition</a>.
</p>

<h3>Inside a button while it works</h3>
<p>The button keeps its label and gains a spinner, and is disabled until the work is done.</p>
{% set classless %}
<form class="card" style="max-width: 24rem">
  <label class="label"><p>Email</p><input class="input" type="email" value="name@example.com" /></label>
  <button class="btn" disabled aria-busy="true"><span class="loading" style="vertical-align: middle"></span> Sending</button>
</form>
{% endset %}
{{ m.demo("loading-comp-1", classless) }}
<ul>
  <li><strong>Controls:</strong> the spinner draws in <code>currentColor</code>, so it takes the button's text colour in any variant.</li>
  <li><strong>Boundary:</strong> <code>disabled</code> greys the button, spinner included, with no extra class.</li>
</ul>
{% endblock %}
